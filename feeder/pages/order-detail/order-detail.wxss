.container {
  padding: 30rpx;
  padding-bottom: 150rpx;
}

.status-section {
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #FF9D5C, #FF7F50);
  color: #ffffff;
}

.status-header {
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.status-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.create-time {
  font-size: 24rpx;
  opacity: 0.8;
}

.user-section,
.service-section,
.fee-section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 25rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #FF9D5C;
  color: white;
  font-size: 40rpx;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.user-phone {
  font-size: 26rpx;
  color: #999999;
}

.contact-btn {
  padding: 15rpx 30rpx;
  background-color: #FF9D5C;
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 26rpx;
  border: none;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999999;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

.fee-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.fee-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
}

.fee-name {
  font-size: 28rpx;
  color: #666666;
}

.fee-price {
  font-size: 28rpx;
  color: #333333;
}

.fee-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
  margin-top: 10rpx;
}

.total-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.total-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF9D5C;
}

.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn-primary {
  width: 100%;
  padding: 25rpx;
  font-size: 32rpx;
  border-radius: 50rpx;
  background-color: #FF9D5C;
  color: #ffffff;
  border: none;
}
