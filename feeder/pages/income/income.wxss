.container {
  padding: 0;
  background-color: #FFF9F0;
  min-height: 100vh;
}

.summary-card {
  margin: 30rpx;
  padding: 40rpx 35rpx;
  background: linear-gradient(135deg, #FF9D5C, #FF7F50);
  border-radius: 24rpx;
  color: #ffffff;
}

.summary-header {
  margin-bottom: 35rpx;
}

.summary-title {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 15rpx;
}

.summary-balance {
  font-size: 56rpx;
  font-weight: bold;
}

.withdraw-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.withdraw-btn {
  width: 200rpx;
  height: 72rpx;
  background-color: #ffffff;
  color: #FF9D5C;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 36rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border: none;
}

.withdraw-history {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.history-icon {
  font-size: 28rpx;
}

.history-text {
  font-size: 26rpx;
  opacity: 0.9;
}

.stats-card {
  margin: 0 30rpx 30rpx;
  padding: 35rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.total-amount {
  font-size: 26rpx;
  color: #999999;
}

.tab-bar {
  display: flex;
  justify-content: space-around;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  position: relative;
  padding: 10rpx 30rpx;
}

.tab-text {
  font-size: 28rpx;
  color: #666666;
  transition: all 0.3s;
}

.tab-item.active .tab-text {
  color: #FF9D5C;
  font-weight: bold;
}

.tab-line {
  position: absolute;
  bottom: -5rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #FF9D5C;
  border-radius: 3rpx;
}

.current-income {
  text-align: center;
  padding: 20rpx 0;
}

.income-label {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 10rpx;
}

.income-amount {
  font-size: 64rpx;
  font-weight: bold;
  color: #FF9D5C;
}

.income-unit {
  font-size: 28rpx;
  color: #999999;
  margin-left: 10rpx;
}

.income-section {
  margin: 0 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.section-count {
  font-size: 26rpx;
  color: #999999;
}

.income-list {
  margin-bottom: 30rpx;
}

.income-card {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.income-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.owner-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.owner-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  margin-right: 20rpx;
}

.avatar-text {
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #FF9D5C;
  color: white;
  font-size: 36rpx;
  font-weight: bold;
}

.owner-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.owner-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.order-id {
  font-size: 24rpx;
  color: #999999;
}

.income-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.income-status.completed {
  background-color: #E8F5E9;
  color: #4CAF50;
}

.income-body {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.service-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.service-names {
  font-size: 28rpx;
  color: #666666;
}

.service-time {
  font-size: 24rpx;
  color: #999999;
}

.income-amount-wrapper {
  display: flex;
  align-items: baseline;
}

.income-symbol {
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: bold;
  margin-right: 4rpx;
}

.income-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #4CAF50;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}
