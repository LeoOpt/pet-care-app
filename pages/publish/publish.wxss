/* pages/publish/publish.wxss */

.section-title {
  margin-bottom: 24rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3436;
}

/* 宠物选择 */
.pet-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pet-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #F0F0F0;
  border-radius: 20rpx;
  position: relative;
}

.pet-item.selected {
  border-color: #FF9D5C;
  background: rgba(255, 157, 92, 0.05);
}

.pet-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.pet-info {
  flex: 1;
}

.pet-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2D3436;
  margin-bottom: 6rpx;
}

.pet-detail {
  font-size: 24rpx;
  color: #636E72;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
  background: #FF9D5C;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

.add-pet {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  border: 2rpx dashed #E0E0E0;
  border-radius: 20rpx;
  color: #999999;
  font-size: 26rpx;
}

.add-icon {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #999999;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 服务类型网格 */
.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.service-option {
  padding: 24rpx;
  border: 2rpx solid #F0F0F0;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2D3436;
  position: relative;
}

.service-option.selected {
  border-color: #FF9D5C;
  background: rgba(255, 157, 92, 0.1);
  color: #FF9D5C;
  font-weight: 500;
}

.service-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  background: #FF9D5C;
  color: #ffffff;
  border-radius: 50%;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 日期选择 */
.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.date-label {
  font-size: 24rpx;
  color: #636E72;
  margin-bottom: 8rpx;
}

.date-value {
  padding: 20rpx;
  background: #F9F9F9;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #2D3436;
  text-align: center;
}

.date-separator {
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #999999;
  padding-bottom: 10rpx;
}

/* 地址输入 */
.address-input-wrapper {
  display: flex;
  align-items: center;
  background: #F9F9F9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.address-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.address-input {
  flex: 1;
  font-size: 28rpx;
  color: #2D3436;
}

/* 备注文本域 */
.notes-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  background: #F9F9F9;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #2D3436;
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-wrapper {
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF9D5C 0%, #FF7B30 100%);
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
