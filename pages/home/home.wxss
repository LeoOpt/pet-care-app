.search-bar {
  padding: 20rpx 30rpx;
  background-color: #FF9D5C;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 50rpx;
  padding: 15rpx 30rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.service-section {
  padding: 30rpx;
  background-color: #ffffff;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
}

.service-grid {
  display: flex;
  justify-content: space-between;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
  padding: 20rpx 10rpx;
  background-color: #f9f9f9;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.service-item:active {
  transform: scale(0.95);
  background-color: #f0f0f0;
}

.service-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 15rpx;
}

.icon-text {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
}

.service-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.service-desc {
  font-size: 20rpx;
  color: #999999;
}

.feeder-section {
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.more-btn {
  font-size: 26rpx;
  color: #FF9D5C;
}

.feeder-list {
  margin-bottom: 150rpx;
}

.feeder-card {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.feeder-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.avatar-wrapper {
  position: relative;
  margin-right: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.avatar-text {
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #FF9D5C;
  color: white;
  font-size: 48rpx;
  font-weight: bold;
}

.verified-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background-color: #4CAF50;
  color: white;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 20rpx;
  border: 3rpx solid white;
}

.feeder-info {
  flex: 1;
}

.feeder-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.feeder-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 15rpx;
}

.rating {
  color: #FF9D5C;
  font-size: 26rpx;
}

.review-count {
  color: #999999;
  font-size: 24rpx;
}

.feeder-price {
  text-align: right;
}

.price {
  color: #FF9D5C;
  font-size: 36rpx;
  font-weight: bold;
}

.price-unit {
  color: #999999;
  font-size: 24rpx;
}

.feeder-intro {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.feeder-tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  display: inline-block;
  background-color: #FFF0E6;
  color: #FF9D5C;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.publish-btn-fixed {
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  z-index: 100;
}

.publish-btn-fixed .btn-primary {
  width: 100%;
  padding: 25rpx;
  font-size: 32rpx;
  border-radius: 50rpx;
  background-color: #FF9D5C;
  color: #ffffff;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(255, 157, 92, 0.4);
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 10rpx;
}
