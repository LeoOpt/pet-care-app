.container {
  padding: 30rpx;
  padding-bottom: 120rpx;
}

.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  padding: 30rpx 0;
  background-color: #ffffff;
  border-radius: 20rpx;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.step-num {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
  color: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.step-item.active .step-num {
  background-color: #FF9D5C;
}

.step-text {
  font-size: 22rpx;
  color: #999999;
}

.step-item.active .step-text {
  color: #FF9D5C;
}

.step-line {
  width: 60rpx;
  height: 4rpx;
  background-color: #e0e0e0;
  margin: 0 15rpx;
  margin-bottom: 30rpx;
}

.step-line.active {
  background-color: #FF9D5C;
}

.step-content {
  min-height: 500rpx;
}

.step-panel {
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.form-section {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 25rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 15rpx;
}

.form-label.required::after {
  content: ' *';
  color: #FF9D5C;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.certification-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.cert-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  border: 4rpx solid transparent;
  transition: all 0.3s;
}

.cert-item.selected {
  background-color: #FFF0E6;
  border-color: #FF9D5C;
}

.cert-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
}

.cert-name {
  font-size: 28rpx;
  color: #333333;
}

.image-upload-row {
  display: flex;
  gap: 30rpx;
}

.image-upload-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-box {
  width: 100%;
  height: 300rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 2rpx dashed #dddddd;
  overflow: hidden;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
}

.upload-icon {
  font-size: 60rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999999;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.upload-tip {
  font-size: 22rpx;
  color: #999999;
  margin-top: 15rpx;
  text-align: center;
}

.notice-card {
  background-color: #FFF9F0;
  border-radius: 16rpx;
  padding: 30rpx;
  border-left: 8rpx solid #FF9D5C;
}

.notice-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 15rpx;
}

.notice-content {
  display: block;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #4CAF50;
  color: white;
  font-size: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 auto 30rpx;
}

.success-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  margin-bottom: 15rpx;
}

.success-desc {
  display: block;
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 40rpx;
}

.info-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #999999;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
}

.agreement-text {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
}

.link {
  color: #FF9D5C;
}

.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn-default,
.btn-primary {
  flex: 1;
  padding: 25rpx;
  font-size: 30rpx;
  border-radius: 50rpx;
  border: none;
}

.btn-default {
  background-color: #ffffff;
  color: #999999;
  border: 2rpx solid #dddddd;
}

.btn-primary {
  background-color: #FF9D5C;
  color: #ffffff;
}

.btn-primary.half {
  flex: 2;
}
