<view class="container" wx:if="{{order}}">
  <view class="status-section card">
    <view class="status-header">
      <text class="status-text {{order.status}}">{{order.statusText}}</text>
      <text class="status-desc">{{order.statusDesc}}</text>
    </view>
    <view class="create-time">下单时间：{{order.createTime}}</view>
  </view>

  <view class="feeder-section card">
    <view class="section-title">喂养师信息</view>
    <view class="feeder-info">
      <view class="feeder-avatar avatar-text">{{order.feederAvatarLetter}}</view>
      <view class="feeder-detail">
        <text class="feeder-name">{{order.feederName}}</text>
        <text class="feeder-rating">★ 4.8</text>
      </view>
      <button class="contact-btn" bindtap="contactFeeder">联系</button>
    </view>
  </view>

  <view class="service-section card">
    <view class="section-title">服务信息</view>
    <view class="info-list">
      <view class="info-item">
        <text class="info-label">服务项目</text>
        <text class="info-value">{{order.services.length > 0 ? order.services[0].name : ''}}{{order.services.length > 1 ? '等' + order.services.length + '项' : ''}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">服务宠物</text>
        <text class="info-value">{{order.pets.length > 0 ? order.pets.join('、') : '未指定'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">服务时间</text>
        <text class="info-value">{{order.serviceTime}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">服务地址</text>
        <text class="info-value">{{order.serviceAddress}}</text>
      </view>
      <view class="info-item" wx:if="{{order.remark}}">
        <text class="info-label">备注信息</text>
        <text class="info-value">{{order.remark}}</text>
      </view>
    </view>
  </view>

  <view class="fee-section card">
    <view class="section-title">费用明细</view>
    <view class="fee-list">
      <view class="fee-item" wx:for="{{order.services}}" wx:key="index">
        <text class="fee-name">{{item.name}}</text>
        <text class="fee-price">¥{{item.price}}</text>
      </view>
      <view class="fee-total">
        <text class="total-label">合计</text>
        <text class="total-price">¥{{order.totalAmount}}</text>
      </view>
    </view>
  </view>

  <view class="action-section">
    <button 
      class="btn-cancel" 
      wx:if="{{order.status === 'pending' || order.status === 'processing'}}"
      bindtap="cancelOrder"
    >取消订单</button>
    
    <button 
      class="btn-confirm" 
      wx:if="{{order.status === 'processing'}}"
      bindtap="confirmComplete"
    >确认完成</button>

    <button 
      class="btn-rate" 
      wx:if="{{order.status === 'completed'}}"
      bindtap="rateOrder"
    >立即评价</button>
  </view>
</view>
