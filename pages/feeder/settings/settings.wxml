<view class="container">
  <view class="section card">
    <view class="section-title">
      <text class="title-icon">📋</text>
      <text class="title-text">服务类型配置</text>
    </view>
    <view class="service-types">
      <view 
        class="service-type-item {{service.enabled ? 'enabled' : ''}}"
        wx:for="{{serviceTypes}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="toggleServiceType"
      >
        <view class="service-info">
          <text class="service-name">{{item.name}}</text>
          <text class="service-desc">{{item.desc}}</text>
        </view>
        <switch 
          checked="{{service.enabled}}" 
          data-id="{{item.id}}"
          bindchange="onServiceTypeChange"
          color="#FF9D5C"
        />
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">
      <text class="title-icon">💰</text>
      <text class="title-text">服务价格设置</text>
    </view>
    <view class="price-list">
      <view 
        class="price-item"
        wx:for="{{serviceTypes}}"
        wx:key="id"
        wx:if="{{service.enabled}}"
      >
        <text class="price-label">{{item.name}}</text>
        <view class="price-input-wrapper">
          <text class="price-symbol">¥</text>
          <input 
            class="price-input" 
            type="digit"
            value="{{item.price}}"
            data-id="{{item.id}}"
            bindinput="onPriceInput"
            placeholder="0"
          />
          <text class="price-unit">/次</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">
      <text class="title-icon">⏰</text>
      <text class="title-text">服务时间设置</text>
    </view>
    <view class="time-settings">
      <view class="time-row">
        <view class="time-label">开始接单时间</view>
        <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
          <view class="time-picker">
            <text>{{startTime || '请选择'}}</text>
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="time-row">
        <view class="time-label">结束接单时间</view>
        <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
          <view class="time-picker">
            <text>{{endTime || '请选择'}}</text>
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="time-row">
        <view class="time-label">预约提前时间</view>
        <picker mode="selector" range="{{advanceOptions}}" value="{{advanceIndex}}" bindchange="onAdvanceChange">
          <view class="time-picker">
            <text>{{advanceOptions[advanceIndex]}}</text>
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">
      <text class="title-icon">📍</text>
      <text class="title-text">服务区域设置</text>
    </view>
    <view class="area-settings">
      <view class="area-row">
        <view class="area-label">服务范围</view>
        <view class="area-value">
          <input 
            class="area-input" 
            type="digit"
            value="{{serviceRadius}}"
            bindinput="onRadiusInput"
            placeholder="0"
          />
          <text class="area-unit">公里</text>
        </view>
      </view>
      <view class="area-tip">设置您愿意提供服务的最大距离范围</view>
      
      <view class="area-list">
        <view class="area-item-header">可选服务区域</view>
        <view 
          class="area-item {{item.selected ? 'selected' : ''}}"
          wx:for="{{serviceAreas}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="toggleArea"
        >
          <view class="area-checkbox">
            <text wx:if="{{item.selected}}">✓</text>
          </view>
          <text class="area-name">{{item.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="action-section">
    <button class="save-btn" bindtap="saveSettings">保存设置</button>
  </view>
</view>
