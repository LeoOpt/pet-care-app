<view class="container">
  <view class="user-section">
    <view class="user-info">
      <view class="avatar-wrapper" bindtap="onAvatarTap">
        <view class="avatar avatar-text">{{userInfo.avatarLetter}}</view>
        <view class="avatar-edit">✏️</view>
      </view>
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickName}}</text>
        <text class="phone">{{userInfo.phone}}</text>
      </view>
    </view>
    
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{stats.orders}}</text>
        <text class="stat-label">订单</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{stats.pets}}</text>
        <text class="stat-label">宠物</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">¥{{stats.balance}}</text>
        <text class="stat-label">余额</text>
      </view>
    </view>
  </view>

  <view class="publish-card" bindtap="goToPublish">
    <view class="publish-content">
      <text class="publish-icon">📝</text>
      <view class="publish-text">
        <text class="publish-title">发布需求</text>
        <text class="publish-desc">快速发布宠物服务需求</text>
      </view>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="menu-section">
    <view 
      class="menu-item"
      wx:for="{{menuItems}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onMenuTap"
    >
      <view class="menu-left">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-name">{{item.name}}</text>
        <view class="badge" wx:if="{{item.badge}}">{{item.badge}}</view>
      </view>
      <text class="menu-arrow" wx:if="{{item.arrow}}">›</text>
    </view>
  </view>

  <view class="menu-section">
    <view 
      class="menu-item"
      wx:for="{{otherItems}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onMenuTap"
    >
      <view class="menu-left">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-name">{{item.name}}</text>
      </view>
      <text class="menu-arrow" wx:if="{{item.arrow}}">›</text>
    </view>
  </view>

  <view class="switch-section">
    <button class="switch-btn" bindtap="switchToFeeder">
      <text class="switch-icon">👤</text>
      切换为服务者
    </button>
  </view>

  <view class="logout-section">
    <button class="logout-btn">退出登录</button>
  </view>
</view>
