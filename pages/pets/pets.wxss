.container {
  padding: 30rpx;
  padding-bottom: 150rpx;
}

.pet-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pet-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.pet-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 25rpx;
}

.pet-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #FFF0E6;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
}

.pet-emoji {
  font-size: 50rpx;
}

.pet-info {
  flex: 1;
}

.pet-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.pet-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 15rpx;
}

.pet-breed {
  font-size: 24rpx;
  color: #999999;
}

.pet-meta {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.pet-tags {
  display: flex;
  gap: 10rpx;
}

.pet-tag {
  display: inline-block;
  background-color: #FFF0E6;
  color: #FF9D5C;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.pet-actions {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #FF9D5C;
  padding: 8rpx 20rpx;
  border: 2rpx solid #FF9D5C;
  border-radius: 6rpx;
}

.pet-details {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  padding-top: 25rpx;
  border-top: 1rpx solid #f0f0f0;
}

.detail-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #999999;
}

.detail-value {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

.set-default-btn {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 15rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

.add-btn-fixed {
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  z-index: 100;
}

.add-btn-fixed .btn-primary {
  width: 100%;
  padding: 25rpx;
  font-size: 32rpx;
  border-radius: 50rpx;
  background-color: #FF9D5C;
  color: #ffffff;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(255, 157, 92, 0.4);
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 10rpx;
}
