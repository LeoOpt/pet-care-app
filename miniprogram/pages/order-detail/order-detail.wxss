/* pages/order-detail/order-detail.wxss */

.status-card {
  background: linear-gradient(135deg, #FF9D5C 0%, #FF7B30 100%);
  border-radius: 24rpx;
  padding: 36rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.status-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  margin-right: 24rpx;
}

.status-info {
  flex: 1;
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.status-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.section-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: #636E72;
  flex-shrink: 0;
  width: 140rpx;
}

.info-value {
  font-size: 26rpx;
  color: #2D3436;
  text-align: right;
  flex: 1;
  line-height: 1.5;
}

.feeder-info {
  display: flex;
  align-items: center;
}

.feeder-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
}

.feeder-detail {
  flex: 1;
}

.feeder-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2D3436;
  margin-bottom: 10rpx;
}

.feeder-services {
  display: flex;
  gap: 10rpx;
}

.service-tag {
  background: #F5F5F5;
  color: #636E72;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
}

.contact-btn {
  padding: 12rpx 24rpx;
  background: #FFF9F0;
  color: #FF9D5C;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.price-label {
  font-size: 26rpx;
  color: #636E72;
}

.price-value {
  font-size: 28rpx;
  color: #2D3436;
}

.price-total {
  display: flex;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #F5F5F5;
  margin-top: 20rpx;
}

.total-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #2D3436;
}

.total-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #FF9D5C;
}

.footer-actions {
  padding-top: 20rpx;
  padding-bottom: 40rpx;
}

.action-btn {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.action-btn.secondary {
  background: #F5F5F5;
  color: #636E72;
}
