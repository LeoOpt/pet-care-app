<!--pages/order-detail/order-detail.wxml-->
<view class="container">
  <!-- 订单状态 -->
  <view class="status-card">
    <view class="status-icon status-{{order.statusType}}"></view>
    <view class="status-info">
      <view class="status-text">{{order.status}}</view>
      <view class="status-desc">订单已创建，等待喂养师确认</view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="section-card">
    <view class="section-title">订单信息</view>
    <view class="info-item">
      <text class="info-label">订单号</text>
      <text class="info-value">{{order.orderNo}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">创建时间</text>
      <text class="info-value">{{order.createTime}}</text>
    </view>
  </view>

  <!-- 喂养师信息 -->
  <view class="section-card">
    <view class="section-title">服务人员</view>
    <view class="feeder-info">
      <image class="feeder-avatar" src="{{order.feederAvatar}}" mode="aspectFill"></image>
      <view class="feeder-detail">
        <view class="feeder-name">{{order.feederName}}</view>
        <view class="feeder-services">
          <text wx:for="{{order.services}}" wx:key="*this" class="service-tag">{{item}}</text>
        </view>
      </view>
      <view class="contact-btn" bindtap="handleContact">联系</view>
    </view>
  </view>

  <!-- 服务信息 -->
  <view class="section-card">
    <view class="section-title">服务信息</view>
    <view class="info-item">
      <text class="info-label">服务项目</text>
      <view class="info-value">
        <text wx:for="{{order.services}}" wx:key="*this" wx:for-item="s" wx:for-index="i">
          {{s}}{{i < order.services.length - 1 ? '、' : ''}}
        </text>
      </view>
    </view>
    <view class="info-item">
      <text class="info-label">服务宠物</text>
      <view class="info-value">
        <text wx:for="{{order.petNames}}" wx:key="*this" wx:for-item="p" wx:for-index="i">
          {{p}}{{i < order.petNames.length - 1 ? '、' : ''}}
        </text>
      </view>
    </view>
    <view class="info-item">
      <text class="info-label">服务时间</text>
      <view class="info-value">
        <view>{{order.startTime}}</view>
        <view>至 {{order.endTime}}</view>
      </view>
    </view>
    <view class="info-item">
      <text class="info-label">服务地址</text>
      <text class="info-value">{{order.address}}</text>
    </view>
    <view class="info-item" wx:if="{{order.notes}}">
      <text class="info-label">备注</text>
      <text class="info-value">{{order.notes}}</text>
    </view>
  </view>

  <!-- 费用信息 -->
  <view class="section-card">
    <view class="section-title">费用明细</view>
    <view class="price-item">
      <text class="price-label">服务费</text>
      <text class="price-value">¥{{order.price.serviceFee}}</text>
    </view>
    <view class="price-item">
      <text class="price-label">其他费用</text>
      <text class="price-value">¥{{order.price.otherFee}}</text>
    </view>
    <view class="price-total">
      <text class="total-label">合计</text>
      <text class="total-value">¥{{order.price.total}}</text>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="footer-actions">
    <button class="action-btn secondary" bindtap="handleCancel">取消订单</button>
  </view>
</view>
