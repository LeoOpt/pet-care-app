<!--pages/home/home.wxml-->
<view class="container">
  <!-- 顶部搜索栏 -->
  <view class="search-bar" bindtap="handleSearch">
    <view class="search-icon">🔍</view>
    <text class="search-text">搜索喂养师或服务</text>
  </view>

  <!-- 服务类型 -->
  <view class="card">
    <view class="services-grid">
      <view 
        wx:for="{{services}}" 
        wx:key="id" 
        class="service-item"
        data-service="{{item.name}}"
        bindtap="handleServiceClick"
      >
        <view class="service-icon">{{item.icon}}</view>
        <text class="service-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 热门喂养师 -->
  <view class="section-header">
    <text class="section-title">热门喂养师</text>
    <text class="section-more">查看全部 ></text>
  </view>

  <!-- 喂养师列表 -->
  <view class="feeder-list">
    <view 
      wx:for="{{feeders}}" 
      wx:key="id" 
      class="feeder-card card"
      data-id="{{item.id}}"
      bindtap="handleFeederClick"
    >
      <view class="feeder-header">
        <image class="feeder-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
        <view class="feeder-info">
          <view class="feeder-name-row">
            <text class="feeder-name">{{item.name}}</text>
            <view wx:if="{{item.isVerified}}" class="verified-badge">
              <text>✓ 已认证</text>
            </view>
          </view>
          <view class="feeder-rating">
            <text class="rating-star">⭐</text>
            <text class="rating-score">{{item.rating}}</text>
            <text class="review-count">({{item.reviewCount}}条评价)</text>
          </view>
        </view>
      </view>
      <view class="feeder-bio">{{item.bio}}</view>
      <view class="feeder-services">
        <text wx:for="{{item.services}}" wx:key="*this" class="service-tag">{{item}}</text>
      </view>
      <view class="feeder-footer">
        <text class="price-text">
          <text class="price-value">¥{{item.pricePerHour}}</text>/小时
        </text>
      </view>
    </view>
  </view>
</view>
