/* pages/home/home.wxss */

/* 搜索栏 */
.search-bar {
  background: #ffffff;
  border-radius: 50rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-text {
  color: #999999;
  font-size: 28rpx;
}

/* 服务类型网格 */
.services-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.service-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.service-name {
  font-size: 24rpx;
  color: #2D3436;
}

/* 章节标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 30rpx 0 20rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3436;
}

.section-more {
  font-size: 26rpx;
  color: #FF9D5C;
}

/* 喂养师卡片 */
.feeder-card {
  cursor: pointer;
}

.feeder-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.feeder-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  margin-right: 24rpx;
}

.feeder-info {
  flex: 1;
}

.feeder-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.feeder-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3436;
  margin-right: 12rpx;
}

.verified-badge {
  background: #E8F5E9;
  color: #4CAF50;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.feeder-rating {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.rating-star {
  margin-right: 4rpx;
}

.rating-score {
  color: #FF9D5C;
  font-weight: 600;
  margin-right: 8rpx;
}

.review-count {
  color: #999999;
}

.feeder-bio {
  color: #636E72;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.feeder-services {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.service-tag {
  background: #FFF9F0;
  color: #FF9D5C;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

.feeder-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.price-text {
  font-size: 26rpx;
  color: #636E72;
}

.price-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #FF9D5C;
}
